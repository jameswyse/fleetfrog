{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "apps/*/vitest.config.ts",
    "packages/*/vitest.config.ts",
    "tools/vitest/**/*.ts",
