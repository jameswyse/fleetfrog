# Cloudflare Pages applies these headers: https://developers.cloudflare.com/pages/configuration/headers/
# The page loads nothing from other origins. Turning on Cloudflare Web Analytics injects a script
# from static.cloudflareinsights.com, which script-src and connect-src would then need to allow.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Vite names each built asset after a hash of its contents, so a changed asset gets a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
