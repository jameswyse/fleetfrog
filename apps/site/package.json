{
  "name": "@fleetfrog/site",
  "version": "0.5.0",
  "private": true,
  "description": "The fleetfrog.dev website, which Cloudflare Workers serves.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
