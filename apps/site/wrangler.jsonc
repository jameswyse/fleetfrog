{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Workers Builds needs the Worker it deploys to have this name.
  "name": "fleetfrog-website",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // fleetfrog.dev is the only address for production. Each pull request's preview gets its own
  // workers.dev address, which Cloudflare's GitHub app comments on the pull request.
  "workers_dev": false,
  "preview_urls": true,
  // `wrangler preview`, which Workers Builds runs for each branch, needs this block even when empty.
  "previews": {},
  "routes": [{ "pattern": "fleetfrog.dev", "custom_domain": true }],
}
