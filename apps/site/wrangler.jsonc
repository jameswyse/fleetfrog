{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Workers Builds needs the Worker it deploys to have this name.
  "name": "fleetfrog-website",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Production is served only at fleetfrog.dev. Each branch's preview is served at a subdomain of
  // it, such as my-branch.fleetfrog.dev, which Cloudflare's GitHub app comments on the pull request.
  "workers_dev": false,
  "preview_urls": true,
  // `wrangler preview`, which Workers Builds runs for each branch, needs this block even when empty.
  "previews": {},
  "routes": [{ "pattern": "fleetfrog.dev", "custom_domain": true, "previews_enabled": true }],
}
