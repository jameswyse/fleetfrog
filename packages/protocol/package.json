{
  "name": "@fleetfrog/protocol",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --list-different .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test:unit": "vitest run",
    "test:unit:changed": "vitest run --changed HEAD --bail=1 --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
